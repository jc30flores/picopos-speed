# Copy this file to .env.docker for local Docker validation. Never commit .env.docker.
# Generate real random secrets before use. In this phase DB_PASSWORD and POSTGRES_PASSWORD must match.
# If APP_HTTP_PORT changes, update CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS too.
# This phase binds only to localhost. Docker runs DTE background processes as separate services; do not commit real tokens.
COMPOSE_PROJECT_NAME=picopos_docker
APP_VERSION=dev
APP_HTTP_PORT=9282

BACKEND_IMAGE=picopos-backend:dev
WEB_IMAGE=picopos-web:dev
POSTGRES_IMAGE=postgres:16-bookworm

DJANGO_CONFIG_MODE=strict
DOTENV_OVERRIDE=false
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-secure-random-value

DB_HOST=db
DB_PORT=5432
DB_NAME=picopos
DB_USER=picopos
DB_PASSWORD=replace-with-a-secure-random-password

POSTGRES_DB=picopos
POSTGRES_USER=picopos
POSTGRES_PASSWORD=replace-with-a-secure-random-password

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:9282
CSRF_TRUSTED_ORIGINS=http://localhost:9282

DJANGO_MEDIA_ROOT=/app/var/media
DJANGO_STATIC_ROOT=/app/var/static
DTE_LOG_DIR=/app/var/dte_logs
TZ=America/El_Salvador

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# DTE remains active in Docker; worker/monitor run as separate services. Use placeholders only in Git.
DTE_BACKGROUND_MODE=external
DTE_BASE_URL=replace-with-dte-api-base-url
DTE_API_TOKEN=replace-with-dte-api-token
DTE_API_AUTH_HEADER=Authorization
DTE_API_AUTH_PREFIX=Bearer
DTE_MONITOR_ENABLED=true
DTE_OUTBOX_WORKER_ENABLED=true
DTE_SENTINEL_ENABLED=true
DTE_MAX_RETRIES=5
DTE_PENDING_BATCH_SIZE=25
DELIVER_EMAIL_API_BASE_URL=
DELIVER_EMAIL_API_KEY=
WHATSAPP_DTE_API_BASE=
WHATSAPP_DTE_API_KEY=
PRINTER_ENABLED=false
PRINTER_MODE=mock
RECEIPT_PRINTER_MODE=mock
CASH_DRAWER_ENABLED=false
CASH_DRAWER_MODE=mock
