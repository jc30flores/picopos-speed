<service>
  <id>PicoDeGallo-PostgreSQL</id>
  <name>Pico de Gallo PostgreSQL</name>
  <description>PostgreSQL local para Pico de Gallo.</description>
  <executable>{{POSTGRES_BIN_DIR}}\postgres.exe</executable>
  <arguments>-D "{{POSTGRES_DATA_DIR}}"</arguments>
  <workingdirectory>{{POSTGRES_BIN_DIR}}</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <logpath>{{PROGRAM_DATA_DIR}}\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
