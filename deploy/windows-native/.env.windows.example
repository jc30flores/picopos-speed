# Safe example for native Windows packaging. The final installer writes the real file to:
# C:/ProgramData/PicoDeGallo/config/.env
DJANGO_CONFIG_MODE=strict
DOTENV_OVERRIDE=false
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-secure-random-value

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=picopos
DB_USER=picopos
DB_PASSWORD=replace-with-secure-password

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:9282
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:9282

DJANGO_MEDIA_ROOT=C:/ProgramData/PicoDeGallo/media
DJANGO_STATIC_ROOT=C:/ProgramData/PicoDeGallo/static
DTE_LOG_DIR=C:/ProgramData/PicoDeGallo/dte_logs

DTE_BACKGROUND_MODE=external
DTE_BASE_URL=replace-with-dte-api-base-url
DTE_API_TOKEN=replace-with-dte-api-token
DTE_API_AUTH_HEADER=Authorization
DTE_API_AUTH_PREFIX=Bearer
DTE_MONITOR_ENABLED=true
DTE_OUTBOX_WORKER_ENABLED=true
DTE_SENTINEL_ENABLED=true
DTE_MAX_RETRIES=5
DTE_PENDING_BATCH_SIZE=25

# Solo para instaladores 0.1.x de prueba. Cambiar o desactivar antes de produccion.
PICO_BOOTSTRAP_ADMIN_ENABLED=true
PICO_BOOTSTRAP_ADMIN_USERNAME=admin
PICO_BOOTSTRAP_ADMIN_PASSWORD=000000

PRINTER_ENABLED=false
PRINTER_MODE=disabled
CASH_DRAWER_ENABLED=false
CASH_DRAWER_MODE=disabled

APP_HTTP_PORT=9282
APP_BIND_ADDRESS=127.0.0.1
