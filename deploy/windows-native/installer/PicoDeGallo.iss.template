; Inno Setup template placeholder for future PicoDeGallo-Setup.exe
#define MyAppName "Pico de Gallo"
#define MyAppVersion "{{VERSION}}"
[Setup]
AppName={#MyAppName}
AppVersion={#MyAppVersion}
DefaultDirName={autopf}\PicoDeGallo
DefaultGroupName=Pico de Gallo
OutputBaseFilename=PicoDeGallo-Setup
[Files]
Source: "{{RELEASE_DIR}}\ProgramFiles\PicoDeGallo\*"; DestDir: "{app}"; Flags: recursesubdirs
[Run]
Filename: "powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File \"{app}\scripts\install-services.ps1\""; Flags: runhidden
