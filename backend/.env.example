# Pico de Gallo backend runtime configuration example. Safe placeholders only.
# legacy: default transitional mode; keeps native Ubuntu fallbacks for compatibility.
# strict: future Docker/production mode; requires critical variables and avoids insecure secret fallbacks.
DJANGO_CONFIG_MODE=legacy
# DOTENV_OVERRIDE=false preserves OS environment precedence. true lets backend/.env replace existing OS vars.
DOTENV_OVERRIDE=false
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-secure-random-value

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=picopos
DB_USER=picopos
DB_PASSWORD=replace-with-a-secure-password

# Hosts only, no http:// or https://. In strict this is required and cannot be empty.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins must include http:// or https://. *_EXTRA appends without duplicates.
CORS_ALLOWED_ORIGINS=http://localhost:8182
CORS_ALLOWED_ORIGINS_EXTRA=
CSRF_TRUSTED_ORIGINS=http://localhost:8182
CSRF_TRUSTED_ORIGINS_EXTRA=

# POSIX paths for future Docker. Empty keeps current native Ubuntu paths.
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=
DTE_LOG_DIR=

# DTE placeholders: disabled/minimal by default; fill only in controlled production setup.
DTE_BACKGROUND_MODE=legacy
DTE_BASE_URL=
DTE_API_TOKEN=
MH_AMBIENTE=00

# Printing/cash drawer placeholders: keep disabled/mock for Docker prep; native config remains external.
PRINTER_ENABLED=false
CASH_DRAWER_ENABLED=false
CASH_DRAWER_MODE=mock
