# 00 pruebas, 01 producción
MH_AMBIENTE=00

# URL base del bridge DTE
DTE_BASE_URL=

DTE_API_AUTH_HEADER=Authorization
DTE_API_AUTH_PREFIX=Bearer
DTE_API_TOKEN=

DTE_TIMEOUT_SECONDS=30
DTE_CONNECT_TIMEOUT=3
DTE_READ_TIMEOUT=15
DTE_MAX_RETRIES=5
DTE_OUTBOX_INTERVAL=2
DTE_OUTBOX_WORKER_ENABLED=1
DTE_BACKOFF_BASE_SECONDS=10
DTE_BACKOFF_MAX_SECONDS=600
DTE_MONITOR_MAX_BACKOFF_SECONDS=30
DTE_ERROR_LOG_COOLDOWN_SECONDS=30
DTE_DEBUG_LOG_PAYLOAD=0
DTE_AUTORETRY_BACKOFF_SECONDS=60
DTE_AUTORETRY_BATCH_SIZE=25

# Sentinel health-check
DTE_SENTINEL_ENABLED=1
DTE_HEALTH_INTERVAL_SECONDS=5
DTE_HEALTH_TIMEOUT_SECONDS=3
DTE_HEALTH_USE_AUTH=0
# Opcional: si no se define, usa ${DTE_BASE_URL}/health
DTE_HEALTH_URL=

# Dev only: show full secrets in startup/curl logs (0 masks token)
DTE_LOG_SECRETS=0
